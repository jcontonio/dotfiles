# Anker PowerConf C200: apply saved settings whenever the camera is plugged in.
# index==0 keeps this from firing a second time for the metadata node.
ACTION=="add", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="291a", ATTRS{idProduct}=="3369", ATTR{index}=="0", TAG+="systemd", ENV{SYSTEMD_WANTS}="anker-c200.service"
