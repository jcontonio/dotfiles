#!/bin/bash

# Tint Personal Ghostty: write the current theme's background, mixed toward the
# theme's magenta (palette 5), to ~/.config/ghostty/personal.conf, then reload
# running Ghostty instances so open Personal windows pick it up.

strength=6 # percent of tint mixed into the background

theme=~/.local/state/omarchy/current/theme/ghostty.conf
out=~/.config/ghostty/personal.conf

bg=$(sed -n 's/^background *= *#\{0,1\}\([0-9a-fA-F]\{6\}\).*/\1/p' "$theme" | head -1)
tint=$(sed -n 's/^palette *= *5=#\{0,1\}\([0-9a-fA-F]\{6\}\).*/\1/p' "$theme" | head -1)
[[ -n $bg && -n $tint ]] || exit 0

mix() {
  printf '%02x' $(((16#$1 * (100 - strength) + 16#$2 * strength) / 100))
}

color=$(mix "${bg:0:2}" "${tint:0:2}")$(mix "${bg:2:2}" "${tint:2:2}")$(mix "${bg:4:2}" "${tint:4:2}")

printf '# Generated by the ghostty-personal-tint theme-set hook; edits are overwritten.\nbackground = #%s\n' "$color" >"$out"

pkill -USR2 -x ghostty || true
